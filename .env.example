# Copy this file to `.env` and fill in the values. `.env` stays on this machine only —
# never share, upload, or let an AI agent read it. Agents read THIS file instead; when a
# project needs a new variable, add it here (with a comment like the ones below) and set
# the real value in `.env` yourself.

# Supabase project URL — Dashboard → Project Settings → API → Project URL
# (looks like https://<ref>.supabase.co). Used by src/server/supabase.ts only.
SUPABASE_URL=

# Supabase service_role key — Dashboard → Project Settings → API Keys →
# tab "Legacy anon, service_role API keys" (direct URL:
# https://supabase.com/dashboard/project/<ref>/settings/api-keys/legacy) → Reveal on
# `service_role` secret. NOT the anon key: the server uses this key to bypass RLS, so the
# browser must never see it. /api/health fails with a hint if the anon key is pasted here
# by mistake. Dashboard UI changes over time — if the menu moved, search Project Settings
# for "API keys" and pick the key labeled service_role/secret.
SUPABASE_SERVICE_ROLE_KEY=

# Port of the production server (`npm run serve:ssr:<project-name>`). `npm start` (ng serve)
# ignores it and uses 4200. Optional — defaults to 4000.
PORT=4000

# Comma-separated hostnames the SSR engine will render for (SSRF protection). `localhost`
# is enough for development; before deploying, set the real domain(s), e.g.
# NG_ALLOWED_HOSTS=my-app.onrender.com — otherwise every page returns 400 in production.
NG_ALLOWED_HOSTS=localhost
